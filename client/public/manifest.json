{
  "name": "Image Filter PWA",
  "short_name": "ImgFilter",
  "description": "A Progressive Web App for filtering images.",
  "start_url": "./index.html",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#1976d2",
  "icons": [
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/screenshot1.png",
      "sizes": "640x480",
      "type": "image/png"
    },
    {
      "src": "screenshots/screenshot2.png",
      "sizes": "1280x720",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Filter Image",
      "short_name": "Filter",
      "description": "Quickly filter an image",
      "url": "/filter",
      "icons": [{ "src": "icons/shortcut-icon.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+imagefilter",
      "url": "/handle-protocol?url=%s"
    }
  ]
}
